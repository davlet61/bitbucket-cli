{
  "name": "bitbucket-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": ["tools/openapi"],
  "bin": {
    "bb": "./src/cli.ts"
  },
  "scripts": {
    "bb": "bun src/cli.ts",
    "generate": "bun run --cwd tools/openapi generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "build": "bun build --compile src/cli.ts --outfile dist/bb",
    "install:local": "bun run build && mkdir -p \"$HOME/.local/bin\" && install -m 755 dist/bb \"$HOME/.local/bin/bb\""
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
